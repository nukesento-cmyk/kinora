# Copy to .env at the repo root (database scripts and tests) and to .env.local in
# apps/web and apps/admin (the apps). Never commit real values.
# Every variable below is validated at startup; the app refuses to boot if one is invalid.

# --- Shared ---
# Public base URLs of each app
APP_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# ISO 3166-1 alpha-2 codes where registration is open, comma-separated.
# Members elsewhere can join the waitlist. Changing this needs no code change.
LAUNCH_MARKETS=KE

# --- Brand (all optional; defaults shown) ---
NEXT_PUBLIC_BRAND_NAME=KINORA
NEXT_PUBLIC_BRAND_TAGLINE=A world where everyone belongs.
NEXT_PUBLIC_SUPPORT_EMAIL=

# --- Legal pages (all optional) ---
# Until these are set, the draft legal pages say the details are "to be confirmed".
NEXT_PUBLIC_LEGAL_ENTITY_NAME=
NEXT_PUBLIC_LEGAL_ADDRESS=
# Address for privacy requests. Falls back to NEXT_PUBLIC_SUPPORT_EMAIL.
NEXT_PUBLIC_PRIVACY_EMAIL=

# --- Membership prices (optional) ---
# JSON, amounts in minor units, per plan and market. Unset means no prices are shown.
# Free can't be priced. Example: {"plus":{"KE":{"currency":"KES","amountMinor":99900}}}
MEMBERSHIP_PRICES=

# --- Database ---
# Local: `pnpm db:up` starts Postgres in Docker on port 5433 (see docker-compose.yml).
# Later on Neon: use the branch's pooled connection string with ?sslmode=require.
DATABASE_URL=postgresql://kinora:kinora@localhost:5433/kinora

# Server used by integration tests; each test file creates and drops its own database.
TEST_DATABASE_URL=postgresql://kinora:kinora@localhost:5433/postgres

# --- Authentication (member app, Better Auth) ---
# Signs session cookies and tokens. At least 32 characters: `openssl rand -base64 32`.
BETTER_AUTH_SECRET=uemg8IVBkzZ36OKbjHVNw8RgF09q7XSX7QXj5jEPBVY=
# Days between a deletion request and the hard delete by `pnpm jobs:purge-deleted`.
ACCOUNT_DELETION_GRACE_DAYS=30
# Google sign-in appears only when both are set (for existing accounts with the same email).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email ---
# Resend (https://resend.com). Both are required in production: the app won't start without them.
RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. KINORA <hello@your-domain.example>
EMAIL_FROM=
# Local development only: record outgoing email at /api/dev/mailbox instead of sending it.
# Ignored outside development and test, and the app refuses to start with it in production.
DEV_MAILBOX=true

# --- Design system review page at /design (never enable in production) ---
ENABLE_DESIGN_PREVIEW=false
